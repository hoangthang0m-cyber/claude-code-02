rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // campaigns/{campaignId}/contentItems/{contentItemId}/... — video + file sản phẩm của 1 content item.
    // Người đã đăng nhập được tải lên/xem/xóa, giới hạn 200MB mỗi file (khớp MAX_VIDEO_FILE_BYTES
    // trong src/config/upload.ts — loại file & giới hạn 20MB cho file sản phẩm được validate ở client).
    match /campaigns/{campaignId}/contentItems/{contentItemId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size <= 200 * 1024 * 1024;
      allow delete: if request.auth != null;
    }
  }
}
