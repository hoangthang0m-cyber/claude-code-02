rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Content Performance Tracker: membership is a projectMembers/ doc whose id
    // is `${projectId}__${uid}` (see projectMemberDocId).
    function isProjectMember(projectId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/projectMembers/$(projectId + '__' + request.auth.uid));
    }

    // users/ — danh bạ nhân sự: mọi thành viên đăng nhập đọc được (dropdown nhân sự thực hiện...),
    // chỉ chính chủ được sửa hồ sơ mình
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // campaigns/ — thành viên đã đăng nhập được đọc, người tạo hoặc admin được sửa/xóa
    match /campaigns/{campaignId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());

      // campaigns/{campaignId}/contentItems — mỗi dòng trong bảng theo dõi content;
      // đọc: mọi thành viên; sửa/xóa: người tạo dòng đó hoặc admin
      match /contentItems/{contentItemId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
      }
    }

    // contentItems (collection group) — rule lồng ở trên chỉ áp dụng cho truy vấn
    // trực tiếp từng campaign; trang Reports dùng collectionGroup("contentItems")
    // để gộp content từ mọi chiến dịch, Firestore yêu cầu 1 rule riêng cho việc đó.
    match /{path=**}/contentItems/{contentItemId} {
      allow read: if isSignedIn();
    }

    // risks/ — người đã đăng nhập được đọc, chỉ người tạo được sửa/xóa
    match /risks/{riskId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // === Content Performance Tracker (docs/SPEC.md) ===
    // Mọi ghi vào các collection này đi qua route handler + firebase-admin
    // (SPEC §2, §5.3: chặn ở tầng server, không chỉ ẩn ở UI). Client chỉ đọc,
    // qua Firebase Web SDK / onSnapshot, để có realtime (SPEC §6.6).
    // Đọc giới hạn cho thành viên dự án (SPEC §5.1 R4 "không phải thành viên
    // cố mở ... từ chối").

    match /projects/{projectId} {
      allow read: if isProjectMember(projectId);
      allow write: if false;
    }

    // projectGroups/ (project-grouping change) — thư mục gom Project. Tạo/sửa/
    // xoá/lưu trữ nhóm chỉ qua route handler + firebase-admin, giới hạn
    // system_role = manager (design.md Decision 3). Client chỉ đọc (tên + mô tả,
    // không nhạy cảm); số liệu roll-up cấp nhóm đi qua API có lọc quyền.
    match /projectGroups/{groupId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /projectMembers/{memberId} {
      // get: own membership row, or any row of a project you belong to.
      allow get: if isSignedIn() && (
        request.auth.uid == resource.data.user_id ||
        isProjectMember(resource.data.project_id)
      );
      // list: only `where("user_id", "==", <me>)` — Firestore can't prove a
      // list safe when the rule contains exists(); listing a project's members
      // goes through GET /api/projects/[id]/members instead.
      allow list: if isSignedIn() && request.auth.uid == resource.data.user_id;
      allow write: if false;
    }

    // contentItems đọc-scoping siết ở nhóm 7.3 (còn vướng rule collectionGroup
    // của /campaigns cũ ở trên).
    match /contentItems/{contentItemId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /statusHistory/{entryId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Chứa token_encrypted — client KHÔNG được đọc (SPEC §1.5). Toàn bộ qua server.
    match /adAccountConnections/{connectionId} {
      allow read, write: if false;
    }

    // Chứa refresh_token_encrypted của Google (SPEC §6.3). Toàn bộ qua server.
    match /googleConnections/{uid} {
      allow read, write: if false;
    }

    match /adsBindings/{bindingId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /adsMetrics/{metricId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /sheetSyncMappings/{mappingId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /syncRuns/{runId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /syncConflicts/{conflictId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // notifications/ — chủ nhân (recipient_id) đọc + đánh dấu đã đọc; engine
    // tạo/xoá qua server (SPEC §5.7 R1/R2).
    match /notifications/{notificationId} {
      allow read, update: if isOwner(resource.data.recipient_id);
      allow create, delete: if false;
    }

    // notificationPreferences/ — mỗi người tự bật/tắt nhóm của mình (SPEC §5.7 R4).
    match /notificationPreferences/{preferenceId} {
      allow read, delete: if isOwner(resource.data.user_id);
      allow create: if isOwner(request.resource.data.user_id);
      allow update: if isOwner(resource.data.user_id)
        && isOwner(request.resource.data.user_id);
    }

    // === ads-overview-reporting (changes/ads-overview-reporting) ===
    // Trang Báo cáo + cấu hình sản phẩm chỉ dành cho system_role = manager và
    // luôn đi qua route handler (gộp + phân loại + quy đổi tiền tệ ở server).
    // Client không đọc trực tiếp — chặn hết ở đây.
    match /products/{productId} { allow read, write: if false; }
    match /productAccountRules/{ruleId} { allow read, write: if false; }
    match /campaignProductOverrides/{overrideId} { allow read, write: if false; }
    match /adsInsightSnapshots/{snapshotId} { allow read, write: if false; }
    match /adCreativeInsightSnapshots/{snapshotId} { allow read, write: if false; }
    match /adAccountReportSyncStates/{stateId} { allow read, write: if false; }
    match /reportingSettings/{settingsId} { allow read, write: if false; }
    match /currencyRates/{rateId} { allow read, write: if false; }

    // === Team Activity Calendar (docs/team-activity-calendar-spec.md Mục C §6) ===
    // Hai vai trò đọc lại từ `members/{uid}` (bản sao đọc-nhanh của `users`).
    // `members` / `config` / `dueReminders` do server ghi (firebase-admin) —
    // client bị chặn ghi. `calendars` / `calendarItems` mã hoá đầy đủ ma trận
    // quyền ở đây (để test `@firebase/rules-unit-testing` phủ được, task 1.3 /
    // 11.5); app vẫn định tuyến ghi qua `/api/**` để chạy side-effect
    // (tính trường ngày, hàng đợi `dueReminders`, thông báo).

    function calendarMember() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }
    function isCalendarMember() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && calendarMember().active == true;
    }
    function isCalendarManager() {
      return isCalendarMember() && calendarMember().role == "manager";
    }
    function calendarDoc(calId) {
      return get(/databases/$(database)/documents/calendars/$(calId)).data;
    }
    // A lịch con còn nhận mục khi CHƯA lưu trữ (task 4.5 — "mục thành chỉ đọc")
    // và người ghi được phép: Trưởng phòng với mọi lịch, nhân sự chỉ lịch
    // `writeScope == "everyone"` (Mục B — lịch "chỉ Trưởng phòng ghi").
    function canWriteCalendar(calId) {
      return calendarDoc(calId).archived != true
        && (isCalendarManager() || calendarDoc(calId).writeScope == "everyone");
    }
    function isItemEditor(item) {
      return request.auth.uid == item.createdBy
        || request.auth.uid in item.assigneeIds;
    }
    function itemEditableById(itemId) {
      let item = get(/databases/$(database)/documents/calendarItems/$(itemId)).data;
      return canWriteCalendar(item.calendarId)
        && (isCalendarManager() || isItemEditor(item));
    }

    // config/calendarSettings — seed script / admin ghi; mọi thành viên đọc.
    match /config/calendarSettings {
      allow read: if isCalendarMember();
      allow write: if false;
    }

    // members/{uid} — đồng bộ từ `users` lúc đăng nhập + job đối soát, qua server.
    match /members/{uid} {
      allow read: if isCalendarMember();
      allow write: if false;
    }

    // calendars/{calendarId} — đọc: mọi thành viên; tạo/sửa/xoá: chỉ Trưởng phòng.
    match /calendars/{calendarId} {
      allow read: if isCalendarMember();
      allow create, update, delete: if isCalendarManager();
    }

    // calendarItems/{itemId} — đọc: mọi thành viên (ẩn/hiện lịch con là lựa chọn
    // hiển thị, không phải ranh giới bảo mật — Mục B `calendar-access-control`).
    match /calendarItems/{itemId} {
      allow read: if isCalendarMember();

      allow create: if isCalendarMember()
        && request.resource.data.createdBy == request.auth.uid
        && canWriteCalendar(request.resource.data.calendarId);

      // Lịch đích phải nhận mục (chưa lưu trữ + đúng quyền ghi), rồi Trưởng phòng
      // sửa mọi mục / nhân sự chỉ mục mình tạo hoặc mình đảm nhận. Chặn nhân sự
      // chuyển mục sang lịch "chỉ Trưởng phòng ghi" và chặn sửa mục ở lịch đã
      // lưu trữ (kể cả Trưởng phòng).
      allow update: if canWriteCalendar(request.resource.data.calendarId)
        && (isCalendarManager() || isItemEditor(resource.data));

      // Xoá cứng: Trưởng phòng, và lịch chưa lưu trữ. Nhân sự chỉ xoá mềm
      // (update đặt `deletedAt`).
      allow delete: if isCalendarManager()
        && calendarDoc(resource.data.calendarId).archived != true;

      // exceptions/{originalDateKey} — ghi đè một lần hiện của chuỗi lặp; quyền
      // gắn với mục gốc.
      match /exceptions/{originalDateKey} {
        allow read: if isCalendarMember();
        allow write: if itemEditableById(itemId);
      }
    }

    // userCalendarPrefs/{uid} — ẩn/hiện + màu ghi đè, chỉ chính chủ.
    match /userCalendarPrefs/{uid} {
      allow read, write: if isOwner(uid);
    }

    // fcmTokens/{uid}/tokens/{tokenId} — chỉ chính chủ (push hoãn sau v1).
    match /fcmTokens/{uid}/tokens/{tokenId} {
      allow read, write: if isOwner(uid);
    }

    // dueReminders/{reminderId} — hàng đợi nhắc, chỉ server (firebase-admin).
    match /dueReminders/{reminderId} {
      allow read, write: if false;
    }

    // calendarNotifications/{uid}/items/{notifId} — chuông in-app. Chính chủ đọc
    // feed của mình (realtime); ghi chỉ qua server (/api/calendar-notifications).
    match /calendarNotifications/{uid}/items/{notifId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
  }
}
